{
  "entities": {
    "AffiliateLink": {
      "title": "AffiliateLink",
      "description": "An affiliate card containing product info and links.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "url": { "type": "string" },
        "imageUrl": { "type": "string" },
        "discountCode": { "type": "string" },
        "clicks": { "type": "integer" },
        "clickHistory": { "type": "object" },
        "last_clicked": { "type": "string" },
        "daily_click_count": { "type": "object" }
      },
      "required": ["id", "title", "description", "category", "url", "imageUrl"]
    },
    "CategoryMap": {
      "title": "CategoryMap",
      "description": "Category key-to-label mappings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "labels": { "type": "object" }
      },
      "required": ["id", "labels"]
    },
    "SocialLink": {
      "title": "SocialLink",
      "description": "A social media link/handle editable by admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "url": { "type": "string" },
        "platform": { "type": "string" },
        "badge": { "type": "string" },
        "order": { "type": "integer" },
        "disabled": { "type": "boolean" },
        "customIcon": { "type": "string" }
      },
      "required": ["id", "name", "handle", "url", "platform", "order"]
    },
    "HomepageConfig": {
      "title": "HomepageConfig",
      "description": "Customizable homepage branding, content sections, and contact details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "heroHeadline": { "type": "string" },
        "heroSubheadline": { "type": "string" },
        "profilePhotoUrl": { "type": "string" },
        "bioHeadline": { "type": "string" },
        "bioText": { "type": "string" },
        "contactPhoneIt": { "type": "string" },
        "contactPhonePhotos": { "type": "string" },
        "logoText": { "type": "string" },
        "logoSubtext": { "type": "string" },
        "bannerText": { "type": "string" },
        "exploreButtonText": { "type": "string" },
        "exploreButtonLink": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactAddress": { "type": "string" },
        "itServices": { "type": "array" },
        "photoServices": { "type": "array" },
        "testimonials": { "type": "array" },
        "pixelFixReviews": { "type": "array" },
        "instagramPosts": { "type": "array" },
        "galleryItems": { "type": "array" }
      },
      "required": ["id"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "A customer inquiry or doorstep booking request logged to the database.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "serviceType": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "phone", "email", "serviceType", "message", "timestamp"]
    },
    "SoftwareLicense": {
      "title": "SoftwareLicense",
      "description": "A dynamic software product license key listing editable by the administrator.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "string" },
        "badge": { "type": "string" },
        "description": { "type": "string" },
        "licenseType": { "type": "string" },
        "imageUrl": { "type": "string" },
        "features": { "type": "string" },
        "compatibility": { "type": "string" },
        "details": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    },
    "SyncStatus": {
      "title": "SyncStatus",
      "description": "Platform sync status information.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/software_licenses/{licenseId}": {
      "schema": "SoftwareLicense",
      "description": "Collection of available software licenses managed by the administrator."
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Collection of visitor requests and doorstep technician booking entries."
    },
    "/affiliate_links/{linkId}": {
      "schema": "AffiliateLink",
      "description": "Collection of all affiliate links synced across all devices"
    },
    "/affiliate_config/{configId}": {
      "schema": "CategoryMap",
      "description": "Global category mappings and other configuration"
    },
    "/social_links/{linkId}": {
      "schema": "SocialLink",
      "description": "Collection of social media link/handle configurations editable by admin."
    },
    "/site_config/{configId}": {
      "schema": "HomepageConfig",
      "description": "Collection storing dynamic homepage content configurations and sections."
    },
    "/sync_status/{statusId}": {
      "schema": "SyncStatus",
      "description": "Seeding sync status collection used by the platform."
    },
    "/syncStatus/{statusId}": {
      "schema": "SyncStatus",
      "description": "Seeding sync status collection used by the platform."
    },
    "/sync-status/{statusId}": {
      "schema": "SyncStatus",
      "description": "Seeding sync status collection used by the platform."
    }
  }
}
