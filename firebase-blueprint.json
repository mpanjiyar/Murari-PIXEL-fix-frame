{
  "entities": {
    "AffiliateLink": {
      "title": "AffiliateLink",
      "description": "An affiliate card containing product info and links.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "url": { "type": "string" },
        "imageUrl": { "type": "string" },
        "discountCode": { "type": "string" },
        "price": { "type": "string" },
        "originalPrice": { "type": "string" },
        "discountPercentage": { "type": "string" },
        "availability": { "type": "string" },
        "partnerSource": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "clicks": { "type": "integer" },
        "clickHistory": { "type": "object" },
        "last_clicked": { "type": "string" },
        "daily_click_count": { "type": "object" }
      },
      "required": ["id", "title", "description", "category", "url", "imageUrl"]
    },
    "AffiliateConfig": {
      "title": "AffiliateConfig",
      "description": "Category key-to-label mappings and sync status configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "labels": { "type": "object" },
        "status": { "type": "string" },
        "lastRefreshTimestamp": { "type": "string" },
        "showPrices": { "type": "boolean" }
      }
    },
    "SocialLink": {
      "title": "SocialLink",
      "description": "A social media link/handle editable by admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "url": { "type": "string" },
        "platform": { "type": "string" },
        "badge": { "type": "string" },
        "order": { "type": "integer" },
        "disabled": { "type": "boolean" },
        "customIcon": { "type": "string" }
      },
      "required": ["id", "name", "handle", "url", "platform", "order"]
    },
    "HomepageConfig": {
      "title": "HomepageConfig",
      "description": "Customizable homepage branding, content sections, and contact details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "heroHeadline": { "type": "string" },
        "heroSubheadline": { "type": "string" },
        "profilePhotoUrl": { "type": "string" },
        "bioHeadline": { "type": "string" },
        "bioText": { "type": "string" },
        "contactPhoneIt": { "type": "string" },
        "contactPhonePhotos": { "type": "string" },
        "logoText": { "type": "string" },
        "logoSubtext": { "type": "string" },
        "logoUrl": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "bannerText": { "type": "string" },
        "exploreButtonText": { "type": "string" },
        "exploreButtonLink": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactAddress": { "type": "string" },
        "itServices": { "type": "array" },
        "photoServices": { "type": "array" },
        "testimonials": { "type": "array" },
        "pixelFixReviews": { "type": "array" },
        "instagramPosts": { "type": "array" },
        "galleryItems": { "type": "array" }
      },
      "required": ["id"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "A customer inquiry or doorstep booking request logged to the database.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "serviceType": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "phone", "email", "serviceType", "message", "timestamp"]
    },
    "SoftwareLicense": {
      "title": "SoftwareLicense",
      "description": "A dynamic software product license key listing editable by the administrator.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "string" },
        "badge": { "type": "string" },
        "description": { "type": "string" },
        "licenseType": { "type": "string" },
        "imageUrl": { "type": "string" },
        "features": { "type": "string" },
        "compatibility": { "type": "string" },
        "details": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    },
    "VaultItem": {
      "title": "VaultItem",
      "description": "Secure document or file stored inside the Pixel Fix Vault with real-time multi-device sync.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "fileType": { "type": "string" },
        "originalFileName": { "type": "string" },
        "storedFileName": { "type": "string" },
        "mimeType": { "type": "string" },
        "content": { "type": "string" },
        "links": { "type": "array" },
        "sizeBytes": { "type": "integer" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "folder": { "type": "string" },
        "fileDataUrl": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "VaultFolder": {
      "title": "VaultFolder",
      "description": "Directory folder for organizing vault documents and files in real-time.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "VaultDraft": {
      "title": "VaultDraft",
      "description": "Auto-saved document draft protecting against browser crashes and interruptions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "documentId": { "type": "string" },
        "documentName": { "type": "string" },
        "draftContent": { "type": "string" },
        "lastSavedTimestamp": { "type": "string" },
        "deviceId": { "type": "string" }
      },
      "required": ["id", "documentId", "draftContent"]
    },
    "VaultLink": {
      "title": "VaultLink",
      "description": "Curated technical resource link with metadata and category tagging.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "icon": { "type": "string" },
        "notes": { "type": "string" },
        "order": { "type": "integer" }
      },
      "required": ["id", "name", "url", "category"]
    }
  },
  "firestore": {
    "/vault_items/{itemId}": {
      "schema": "VaultItem",
      "description": "Encrypted and secured Pixel Fix Vault documents synchronized across devices in real time."
    },
    "/vault_folders/{folderId}": {
      "schema": "VaultFolder",
      "description": "Directories and organization folders for vault documents and files."
    },
    "/vault_drafts/{draftId}": {
      "schema": "VaultDraft",
      "description": "Temporary auto-saved document drafts synchronized across active sessions."
    },
    "/vault_links/{linkId}": {
      "schema": "VaultLink",
      "description": "Curated technical tools and diagnostic web links."
    },
    "/software_licenses/{licenseId}": {
      "schema": "SoftwareLicense",
      "description": "Collection of available software licenses managed by the administrator."
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Collection of visitor requests and doorstep technician booking entries."
    },
    "/affiliate_links/{linkId}": {
      "schema": "AffiliateLink",
      "description": "Collection of all affiliate links synced across all devices"
    },
    "/affiliate_config/{configId}": {
      "schema": "AffiliateConfig",
      "description": "Global category mappings or sync status configuration"
    },
    "/social_links/{linkId}": {
      "schema": "SocialLink",
      "description": "Collection of social media link/handle configurations editable by admin."
    },
    "/site_config/{configId}": {
      "schema": "HomepageConfig",
      "description": "Collection storing dynamic homepage content configurations and sections."
    }
  }
}
