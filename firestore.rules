rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Rule 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isValidAffiliateLink(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 300
        && data.description is string && data.description.size() <= 5000
        && data.category is string && data.category.size() <= 200
        && data.url is string && data.url.size() <= 3000
        && data.imageUrl is string && data.imageUrl.size() <= 10000000
        && (!('discountCode' in data) || (data.discountCode is string && data.discountCode.size() <= 200))
        && (!('clicks' in data) || (data.clicks is int || data.clicks is float))
        && (!('clickHistory' in data) || data.clickHistory is map)
        && (!('last_clicked' in data) || (data.last_clicked is string && data.last_clicked.size() <= 100))
        && (!('daily_click_count' in data) || data.daily_click_count is map);
    }

    function isValidAffiliateConfig(data, configId) {
      return configId == 'labels'
        ? (data.id is string && data.id.size() <= 128 && 'labels' in data && data.labels is map)
        : (configId == 'status'
          ? (data.status is string && data.status.size() <= 50 && data.lastRefreshTimestamp is string && data.lastRefreshTimestamp.size() <= 100)
          : false);
    }

    function isValidSocialLink(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.handle is string && data.handle.size() <= 200
        && data.url is string && data.url.size() <= 3000
        && data.platform is string && data.platform.size() <= 100
        && (!('badge' in data) || (data.badge is string && data.badge.size() <= 100))
        && (!('disabled' in data) || data.disabled is bool)
        && (!('customIcon' in data) || (data.customIcon is string && data.customIcon.size() <= 100))
        && (data.order is int || data.order is float);
    }

    function isValidHomepageConfig(data) {
      return data.id is string && data.id.size() <= 128
        && (!('heroHeadline' in data) || (data.heroHeadline is string && data.heroHeadline.size() <= 1000))
        && (!('heroSubheadline' in data) || (data.heroSubheadline is string && data.heroSubheadline.size() <= 5000))
        && (!('profilePhotoUrl' in data) || (data.profilePhotoUrl is string && data.profilePhotoUrl.size() <= 10000000))
        && (!('bioHeadline' in data) || (data.bioHeadline is string && data.bioHeadline.size() <= 1000))
        && (!('bioText' in data) || (data.bioText is string && data.bioText.size() <= 5000))
        && (!('contactPhoneIt' in data) || (data.contactPhoneIt is string && data.contactPhoneIt.size() <= 100))
        && (!('contactPhonePhotos' in data) || (data.contactPhonePhotos is string && data.contactPhonePhotos.size() <= 100))
        && (!('logoText' in data) || (data.logoText is string && data.logoText.size() <= 200))
        && (!('logoSubtext' in data) || (data.logoSubtext is string && data.logoSubtext.size() <= 500))
        && (!('bannerText' in data) || (data.bannerText is string && data.bannerText.size() <= 1000))
        && (!('exploreButtonText' in data) || (data.exploreButtonText is string && data.exploreButtonText.size() <= 100))
        && (!('exploreButtonLink' in data) || (data.exploreButtonLink is string && data.exploreButtonLink.size() <= 500))
        && (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 500))
        && (!('contactAddress' in data) || (data.contactAddress is string && data.contactAddress.size() <= 1000))
        && (!('itServices' in data) || data.itServices is list)
        && (!('photoServices' in data) || data.photoServices is list)
        && (!('testimonials' in data) || data.testimonials is list)
        && (!('pixelFixReviews' in data) || data.pixelFixReviews is list)
        && (!('instagramPosts' in data) || data.instagramPosts is list)
        && (!('galleryItems' in data) || data.galleryItems is list);
    }

    function isValidContactMessage(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 500
        && data.phone is string && data.phone.size() <= 100
        && data.email is string && data.email.size() <= 500
        && data.serviceType is string && data.serviceType.size() <= 100
        && data.message is string && data.message.size() <= 10000
        && data.timestamp is string && data.timestamp.size() <= 200
        && (!('status' in data) || (data.status is string && data.status.size() <= 100));
    }

    function isValidSoftwareLicense(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 300
        && data.price is string && data.price.size() <= 100
        && (!('badge' in data) || (data.badge is string && data.badge.size() <= 100))
        && (!('description' in data) || (data.description is string && data.description.size() <= 5000))
        && (!('licenseType' in data) || (data.licenseType is string && data.licenseType.size() <= 500))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 10000000))
        && (!('features' in data) || (data.features is string && data.features.size() <= 5000))
        && (!('compatibility' in data) || (data.compatibility is string && data.compatibility.size() <= 1000))
        && (!('details' in data) || (data.details is string && data.details.size() <= 1000))
        && (!('category' in data) || (data.category is string && data.category.size() <= 200));
    }

    // Collection: Contact Messages
    match /contact_messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) && isValidContactMessage(incoming());
      allow update: if isValidId(messageId) && isValidContactMessage(incoming());
      allow delete: if isValidId(messageId);
    }

    // Collection: Affiliate Links
    match /affiliate_links/{linkId} {
      allow read: if true;
      allow create: if isValidId(linkId) && isValidAffiliateLink(incoming());
      allow update: if isValidId(linkId) && isValidAffiliateLink(incoming());
      allow delete: if isValidId(linkId);
    }

    // Collection: Affiliate Config
    match /affiliate_config/{configId} {
      allow read: if true;
      allow create: if isValidId(configId) && isValidAffiliateConfig(incoming(), configId);
      allow update: if isValidId(configId) && isValidAffiliateConfig(incoming(), configId);
      allow delete: if isValidId(configId);
    }

    // Collection: Social Links
    match /social_links/{linkId} {
      allow read: if true;
      allow create: if isValidId(linkId) && isValidSocialLink(incoming());
      allow update: if isValidId(linkId) && isValidSocialLink(incoming());
      allow delete: if isValidId(linkId);
    }

    // Collection: Software Licenses
    match /software_licenses/{licenseId} {
      allow read: if true;
      allow create: if isValidId(licenseId) && isValidSoftwareLicense(incoming());
      allow update: if isValidId(licenseId) && isValidSoftwareLicense(incoming());
      allow delete: if isValidId(licenseId);
    }

    // Collection: Site Config
    match /site_config/{configId} {
      allow read: if true;
      allow create: if isValidId(configId) && isValidHomepageConfig(incoming());
      allow update: if isValidId(configId) && isValidHomepageConfig(incoming());
      allow delete: if isValidId(configId);
    }
  }
}
